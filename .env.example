# Application Port
PORT=3000

# Environment (development | production | test)
NODE_ENV=production

# AWS Region where EC2 instance is deployed
AWS_REGION=us-east-1

# Display titles and themes
APP_TITLE=ShipIt48 - 48h Hackathon Survival Hub
HACKATHON_NAME=Hack48: Sleep is Optional
HACKATHON_HOURS=48

# Security & Admin passcode
ADMIN_PASSCODE=hackathon-secret-key

# ==============================================================================
# CRITICAL DEMO & DEPLOYMENT CONTROLS
# ==============================================================================
# 🚨 Required for Deployment: If missing or set to CHANGE_ME_OR_DEPLOYMENT_CRASHES,
# the app locks down with a critical configuration error screen!
APP_DEPLOYMENT_KEY=CHANGE_ME_OR_DEPLOYMENT_CRASHES

# 🎛️ Hackathon UI State:
# Options:
#   RUNNING     - Normal dashboard with speed-typing cat meme GIF
#   PANIC_MODE  - Red alert theme with "This is Fine" dog in fire meme GIF
#   MAINTENANCE - Meltdown screen locking UI with server fire meme GIF
# Any typo here will cause a visible configuration error banner in the UI!
HACKATHON_STATE=RUNNING

# 🔒 Feature Gate:
# true  - Submissions open
# false - Submissions disabled in UI & backend returns 403 Forbidden
ENABLE_SUBMISSIONS=true
