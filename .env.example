# Application Port (default: 3000)
PORT=3000

# Environment (development | production | test)
NODE_ENV=production

# AWS Region where instance is deployed (used for UI badge & verification)
AWS_REGION=us-east-1

# Display titles and themes
APP_TITLE=ShipIt48 - 48h Hackathon Survival Hub
HACKATHON_NAME=Hack48: Sleep is Optional
HACKATHON_HOURS=48

# Security & Admin passcode for emergency reset
ADMIN_PASSCODE=hackathon-secret-key
